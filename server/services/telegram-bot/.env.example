# The telegram bot normally reads its token and enabled flag from
# ~/.on_server/config.json (set via the Flutter app's Bots screen, which
# calls PUT /api/bots/telegram on control-api). You do NOT need this file
# for normal operation.
#
# These are optional overrides, useful only for local development when you
# want to run the bot standalone against a throwaway test bot/token without
# touching control-api's config:

# Overrides the token normally read from ~/.on_server/config.json
TELEGRAM_BOT_TOKEN=

# Port control-api is listening on (defaults to the value in
# ~/.on_server/config.json, normally 8420)
CONTROL_API_PORT=8420

# Bearer token control-api expects (normally read automatically from
# ~/.on_server/config.json's "token" field; only needed here if you're
# running the bot against a control-api instance whose config it can't see)
CONTROL_API_TOKEN=
